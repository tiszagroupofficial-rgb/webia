{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webia",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b157ba92-d537-4982-8699-517a96cd198d","database_name": "webia" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bff8f98d0e2b4e97adc318b502ed4163" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
